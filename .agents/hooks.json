{
  "backend-safety-guard": {
    "enabled": true,
    "path_filters": ["backend/**/*"],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/backend_safety_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "frontend-safety-guard": {
    "enabled": true,
    "path_filters": ["frontend/**/*"],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/frontend_safety_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "backend-post-tool-audit": {
    "enabled": true,
    "path_filters": ["backend/**/*"],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/backend_post_tool_audit.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "frontend-post-tool-audit": {
    "enabled": true,
    "path_filters": ["frontend/**/*"],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/frontend_post_tool_audit.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "backend-architecture-reminder": {
    "enabled": true,
    "path_filters": ["backend/**/*"],
    "PreInvocation": [
      {
        "type": "command",
        "command": "py hooks/backend_architecture_reminder.py",
        "timeout": 10
      }
    ]
  },
  "frontend-architecture-reminder": {
    "enabled": true,
    "path_filters": ["frontend/**/*"],
    "PreInvocation": [
      {
        "type": "command",
        "command": "py hooks/frontend_architecture_reminder.py",
        "timeout": 10
      }
    ]
  }
}
